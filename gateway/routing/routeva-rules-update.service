[Unit]
Description=Refresh shared Russian-service routing data
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=routeva-rules
Group=routeva-rules
ExecStart=/usr/bin/python3 /usr/local/lib/routeva-rules/update_ru_routing.py
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/routeva-rules
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=256M
TasksMax=64
UMask=0022
